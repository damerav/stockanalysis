FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit plotly requests pandas

COPY src/dashboard/ /app/src/dashboard/
COPY src/__init__.py /app/src/__init__.py

EXPOSE 8501 8502

COPY cloud/start_dashboards.sh /app/start_dashboards.sh
RUN chmod +x /app/start_dashboards.sh

CMD ["/app/start_dashboards.sh"]
