FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn requests

COPY src/sync/relay_server.py /app/src/sync/relay_server.py
COPY src/sync/__init__.py /app/src/sync/__init__.py
COPY src/__init__.py /app/src/__init__.py

EXPOSE 8000

CMD ["uvicorn", "src.sync.relay_server:app", "--host", "0.0.0.0", "--port", "8000"]
